local hideNameEnabled = true
local hideNameRGB = true
local hideNameText = "#BEST ONE CHEAT"
local hideNameColor = Color3.fromRGB(0, 255, 255)
local hideNameColorOverride = false
local nameRGBConnection = nil

local function stopNameRGB()
    if nameRGBConnection then
        nameRGBConnection:Disconnect()
        nameRGBConnection = nil
    end
end

local function updateHideName()
    local Character = Player.Character
    if not Character then
        return false
    end

    local Head = Character:FindFirstChild("Head")
    if not Head then
        return false
    end

    local RankTag = Head:FindFirstChild("RankTag")
    if not RankTag then
        return false
    end

    local MainFrame = RankTag:FindFirstChild("MainFrame")
    if not MainFrame then
        return false
    end

    local NameLabel = MainFrame:FindFirstChild("NameLabel")
    if not NameLabel then
        return false
    end

    stopNameRGB()

    if not hideNameEnabled then
        NameLabel.Text = Player.DisplayName
        return true
    end

    NameLabel.Text = hideNameText

    -- CUSTOM COLOR PUNYA PRIORITAS TERTINGGI
    if hideNameColorOverride then
        NameLabel.TextColor3 = hideNameColor
        return true
    end

    -- RGB
    if hideNameRGB then
        nameRGBConnection = RunService.RenderStepped:Connect(function()
            if not NameLabel.Parent
                or not hideNameEnabled
                or not hideNameRGB
                or hideNameColorOverride then

                stopNameRGB()
                return
            end

            local hue = (os.clock() * 0.2) % 1

            NameLabel.Text = hideNameText
            NameLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
        end)
    else
        NameLabel.TextColor3 = hideNameColor
    end

    return true
end

