local function buyIngredientRemote(itemName, code, packages)
    packages = packages or 1
    if packages < 1 then packages = 1 end
    if packages > 200 then packages = 200 end
    local got = countInv(itemName)
    while got < packages do
        if getgenv().MULTIFARM_STOP then break end
        local before = got
        fireBuyItem(code)
        local t0 = os.clock()
        repeat
            task.wait(0.15)
            got = countInv(itemName)
        until got > before or (os.clock() - t0) > 3
        if got <= before then break end
    end
    return got >= 1
end

local function findNearestPrompt()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local targetNames = { ["cooking pot"] = true, ["cookpot"] = true, ["cook pot"] = true, ["stove"] = true }
    local nearest, nearDist = nil, math.huge
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local part = obj:FindFirstAncestorWhichIsA("BasePart")
            if part and targetNames[part.Name:lower()] then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist < nearDist and dist < 30 then
                    nearDist = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

local function fireNearestPrompt()
    local p = findNearestPrompt()
    if p then
        p.HoldDuration = 0
        p.RequiresLineOfSight = false
        p.MaxActivationDistance = 9e9
        fireproximityprompt(p)
        return true
    end
    return false
end

local function fireStovePrompt()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local keywords = { "stove", "cook", "pot", "kompor", "burner", "heater", "grill", "fire", "pan" }
    local fired = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local part = obj:FindFirstAncestorWhichIsA("BasePart")
            if not part and obj.Parent and obj.Parent:IsA("BasePart") then part = obj.Parent end
            if part then
                local n = tostring(part.Name):lower()
                local match = false
                for _, kw in ipairs(keywords) do
                    if n:find(kw, 1, true) then match = true break end
                end
                if match and (part.Position - hrp.Position).Magnitude <= 40 then
                    pcall(function()
                        obj.HoldDuration = 0
                        obj.RequiresLineOfSight = false
                        obj.MaxActivationDistance = 9e9
                    end)
                    for _ = 1, 3 do
                        pcall(function() fireproximityprompt(obj) end)
                        task.wait()
