    setStatus("TP APART (motor) water ke kompor...")
    if not TeleportVehicleKAGIFromBelow(stovePos or cookTarget) then return false end
    task.wait(0.5)
    if not stovePos then stovePos = findStovePos() end
    if stovePos then
        local nc = noclipKitchenAround(stovePos)
        TeleportVehicleKAGI(stovePos)
        task.wait(0.3)
        deleteApartmentJunk()
        task.wait(0.5)
