        FPSState.skyOverlay = Instance.new("Frame")
        FPSState.skyOverlay.Name = "SkyOverlay"
        FPSState.skyOverlay.Size = UDim2.new(1, 0, 1, 0)
        FPSState.skyOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        FPSState.skyOverlay.BackgroundTransparency = 0
        FPSState.skyOverlay.BorderSizePixel = 0
        FPSState.skyOverlay.ZIndex = -1
        FPSState.skyOverlay.Parent = game:GetService("CoreGui")
    end)
    task.wait(0.05)

    pcall(function()
        fpsLighting.GlobalShadows = false
        fpsLighting.FogEnd = 100000
        fpsLighting.FogStart = 0
        fpsLighting.ShadowSoftness = 0
    end)
    task.wait(0.05)

    pcall(function()
        local terrain = fpsWorkspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
        end
    end)
    task.wait(0.05)

    pcall(function()
        settings().Rendering.QualityLevel = 1
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
    end)
    task.wait(0.05)

    pcall(function()
        if setfpscap then setfpscap(1e6) end
    end)
    task.wait(0.05)

    pcall(function()
        local materialService = game:GetService("MaterialService")
        for _, v in pairs(materialService:GetChildren()) do v:Destroy() end
        materialService.Use2019Materials = false
    end)
    task.wait(0.05)

    local parts = fpsWorkspace:GetDescendants()
    local total = #parts
    for i = 1, total, 500 do
        if not FPSState.enabled then break end
        local endIdx = math.min(i + 499, total)
        for j = i, endIdx do
            local v = parts[j]
            if not fpsIsPartOfCharacter(v) then
                if fpsShouldDelete(v) then
                    pcall(function() v:Destroy(); FPSState.deleted = FPSState.deleted + 1 end)
                end
                if v and v.Parent then
                    pcall(function()
                        if v:IsA("Texture") or v:IsA("Decal") then v:Destroy(); FPSState.deleted = FPSState.deleted + 1 end
                        if v:IsA("MeshPart") then v.TextureID = ""; v.RenderFidelity = 2; v.Reflectance = 0; v.Material = Enum.Material.Plastic end
                        if v:IsA("SpecialMesh") then v.TextureId = ""; v.MeshId = "" end
                        if v:IsA("BasePart") and not v:IsA("MeshPart") then v.Material = Enum.Material.Plastic; v.Reflectance = 0 end
                        if v:IsA("Model") then v.LevelOfDetail = 1 end
                        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then v.Enabled = false end
                        if v:IsA("Explosion") then v.BlastPressure = 1; v.BlastRadius = 1 end
                        if v:IsA("TextLabel") and v:IsDescendantOf(fpsWorkspace) then v.Visible = false end
                        if v:IsA("ShirtGraphic") then v.Graphic = "" end
                        if v:IsA("FaceInstance") then v.Transparency = 1; v.Shiny = 1 end
                    end)
                end
            end
        end
        task.wait(0.05)
    end

    FPSState.running = false
    task.spawn(fpsFogKeeper)
end

local function resetFPSBoost()
    FPSState.enabled = false
    FPSState.running = false
    pcall(function()
        if FPSState.skyOverlay then FPSState.skyOverlay:Destroy(); FPSState.skyOverlay = nil end
