        task.wait(2)
    end

    -- 5. MOTOR KE FAKE ID SELLER -> BANK TELLER (alur seperti multifarm)
    setStatus("TP FAKE ID SELLER...")
    local ID_SELLER = Vector3.new(214.91574096679688, 3.7828574180603027, -332.34600830078125)
