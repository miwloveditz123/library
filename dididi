    -- Sinyal opsional (JANGAN jadi penghalang): TaskUpdate "bag the solution",
    -- lalu fallback timer pot "0". Keduanya cuma mempercantik timing; kalau nggak
    -- ketemu juga langsung fire berkali-kali (pola 5cx yang terbukti jalan).
    if not PH.waitTaskUpdateEmptyBag(20) then
        if not PH.waitKitchenPotReady(15, 20) then
            warn("[MULTIFARM] FIRE EMPTY BAG: sinyal tak terdeteksi, langsung fire terus...")
        end
    end

    -- Loop fire seperti 5cx CookAndPackRobust: terus fire sampai marshmallow bertambah.
    -- Nggak HANYA andalkan count naik — fire 20x bahkan jika prompt ragu-ragu.
    local before = countToolByName("marshmallow")
    local firedAny = false
    for _ = 1, 20 do
        if getgenv().MULTIFARM_STOP then break end
        if countToolByName("marshmallow") > before then
            warn("[MULTIFARM] FIRE EMPTY BAG OK: marshmallow bertambah (" .. before .. " -> " .. countToolByName("marshmallow") .. ")")
            unequipTools()
            return true
        end
        local okP, did = pcall(fireNearestPrompt)
        local okS = pcall(fireStovePrompt)
        if okP and did then firedAny = true end
        if not (okP and did) and okS then firedAny = true end
        task.wait(0.4)
    end
    -- Terakhir: satu cek lagi apakah marshmallow naik (fire bisa telat di-register)
    if countToolByName("marshmallow") > before then
        warn("[MULTIFARM] FIRE EMPTY BAG OK (telat): marshmallow bertambah")
        unequipTools()
        return true
    end
    warn("[MULTIFARM] FIRE EMPTY BAG: marshmallow tidak bertambah (tetap " .. before .. "). fired=" .. tostring(firedAny))
    unequipTools()
    return false
end

