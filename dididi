-- Cara terbukti nunggu masak selesai (South Bronx & alur potato multifarm):
-- Pot.Timer.TextLabel.Text == "0". Cari "Cooking Pot" milik apart terpilih lalu ambil Timer-nya.
PH.findKitchenPotTimer = function()
    local base = selectedApartmentData and selectedApartmentData.cookPos or APARTMENT_POS
    local bestPot, bestD = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local n = tostring(obj.Name):lower()
        if n == "cooking pot" or n == "cookpot" or n == "cook pot" then
            local pos
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") and obj.PrimaryPart then
                pos = obj.PrimaryPart.Position
            end
            if pos then
                local d = (pos - base).Magnitude
                if d < bestD then bestD = d bestPot = obj end
            end
        end
    end
    if not bestPot then return nil end
    local timer = bestPot:FindFirstChild("Timer", true)
    if not timer then return nil end
    local lbl = timer:FindFirstChildOfClass("TextLabel")
    if not lbl and timer:IsA("TextLabel") then lbl = timer end
    return lbl
end

-- Tunggu sampai timer pot masak menunjuk "0" (= masak selesai, saatnya empty bag).
-- Kalau pot/timer tak ketemu -> fallback timer tetap (perilaku lama) supaya PASTI fire.
PH.waitKitchenPotReady = function(fallbackSeconds, maxSeconds)
    local startClock = os.clock()
    local cap = maxSeconds or math.max(fallbackSeconds or 32, 60)
    while true do
        if getgenv().MULTIFARM_STOP then return false end
        local lbl = PH.findKitchenPotTimer()
        if lbl then
            local ok, text = pcall(function() return tostring(lbl.Text) end)
            if ok and text == "0" then return true end
        else
            break -- timer pot tak ketemu -> pakai timer tetap
        end
        local elapsed = os.clock() - startClock
        if elapsed >= cap then
            local left = (fallbackSeconds or 32) - elapsed
            if left > 0 then task.wait(left) end
            return false
        end
        task.wait(0.5)
    end
    startTimer(fallbackSeconds or 32)
    return false
end

