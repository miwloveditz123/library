local MoneyLabel = nil

local function findMoneyLabel()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local function scan(inst)
        for _, child in inst:GetChildren() do
            if child.Name == "Amount" and child:IsA("TextLabel") then
                local parent = child.Parent
                if parent and parent.Name == "Money" then
                    return child
                end
            end
            local hit = scan(child)
            if hit then return hit end
        end
    end
    return scan(pg)
end

local function onMoneyLabelChanged()
    if not MoneyLabel then return end
    local text = MoneyLabel.Text
    if type(text) ~= "string" then return end
    local digits = text:gsub("%D+", "")
    if digits == "" then return end
    local current = tonumber(digits)
    if not current or current <= 0 then return end

    -- baseline pertama (uang saat mulai) -> jangan dihitung
    if MULTIFARM_STAT.PrevCash <= 0 then
        MULTIFARM_STAT.PrevCash = current
        return
    end

    -- HANYA kenaikan yang dihitung -> TotalCashMade
    if current > MULTIFARM_STAT.PrevCash then
        MULTIFARM_STAT.TotalCashMade = MULTIFARM_STAT.TotalCashMade + (current - MULTIFARM_STAT.PrevCash)
    end
    MULTIFARM_STAT.PrevCash = current
end

local function hookMoneyLabel()
    local lb = findMoneyLabel()
    if not lb then return false end
    if MoneyLabel == lb then return true end -- sudah ke-hook, jangan dobel
    MoneyLabel = lb
    pcall(function()
        MoneyLabel:GetPropertyChangedSignal("Text"):Connect(onMoneyLabelChanged)
    end)
    -- baca sekali supaya baseline langsung ke-set
    if MULTIFARM_STAT.PrevCash <= 0 then onMoneyLabelChanged() end
    return true
end

