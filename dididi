local function TweenMotorTo(targetPos, flySpeed)
    flySpeed = flySpeed or 160
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if not hum.SeatPart then
        if not EnsureOnBike() then return false end
        char = Player.Character
        hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or not hum.SeatPart then return false end
    end

    local seat = hum.SeatPart
    local vehicle = seat.Parent
    if not vehicle then return false end

    local prim = vehicle.PrimaryPart or seat
    if not prim then return false end
    local startCF = prim.CFrame
    local goalCF = CFrame.new(targetPos)

    local dist = (goalCF.Position - startCF.Position).Magnitude
    if dist < 3 then
        snapshotVehicleWheels()
        pcall(function() vehicle:PivotTo(goalCF) end)
        applyVehicleWheels()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then pcall(function() hrp.CFrame = goalCF end) end
        return true
    end

    local dur = math.clamp(dist / flySpeed, 1.5, 12)

    snapshotVehicleWheels()
    local anchoredList = {}
    for _, o in pairs(vehicle:GetDescendants()) do
        if o:IsA("BasePart") then anchoredList[o] = o.Anchored; o.Anchored = true end
    end

    local flyPart = Instance.new("Part")
    flyPart.Anchored = true
    flyPart.CanCollide = false
    flyPart.CanQuery = false
    flyPart.CanTouch = false
    flyPart.Transparency = 1
    flyPart.Size = Vector3.new(1, 1, 1)
    flyPart.Parent = Workspace
    flyPart.CFrame = startCF

    local conn
    conn = flyPart:GetPropertyChangedSignal("CFrame"):Connect(function()
        pcall(function() vehicle:PivotTo(flyPart.CFrame) end)
        applyVehicleWheels()
    end)

    local tw = TweenService:Create(flyPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = goalCF })
    tw:Play()
    while tw.PlaybackState == Enum.PlaybackState.Playing do
        if mStop() then pcall(function() tw:Cancel() end) break end
        task.wait(0.05)
    end

    if conn then pcall(function() conn:Disconnect() end) end
    pcall(function() flyPart:Destroy() end)

    pcall(function() vehicle:PivotTo(goalCF) end)

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then pcall(function() hrp.CFrame = goalCF end) end
    for _, o in pairs(anchoredList) do
        if o and o.Parent then pcall(function() o.Anchored = anchoredList[o] end) end
    end
    applyVehicleWheels()
    task.spawn(autoFixVehicleGround)
    return true
end

local function MotorTP(targetPos)
