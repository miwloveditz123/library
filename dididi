local function ATM_findPartByName(name, keyword)
    keyword = keyword or false
    local charPos = nil
    local _, _, hrp = GetLiveCharacter(1)
    if hrp then charPos = hrp.Position end
    local bestPart, bestD = nil, math.huge
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            local n = tostring(part.Name):lower()
            local target = tostring(name):lower()
            local hit = (keyword and n:find(target, 1, true)) or (not keyword and n == target)
            if hit then
                local d = charPos and (part.Position - charPos).Magnitude or 0
                if d < bestD then
                    bestD = d
                    bestPart = part
                end
            end
        end
    end
    return bestPart
end

