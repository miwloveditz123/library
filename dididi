    -- 8. MOTOR KE KOMPOR APART: taruh sugar + gelatin (jangan tunggu masak)
    setStatus("TP APART (taruh bahan masak)...")
    local stovePos2 = findStovePos()
    if not TeleportVehicleKAGIFromBelow(stovePos2 or cookTarget) then return false end
