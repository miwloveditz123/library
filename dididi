                    Font = FontFace or UiFont,
                    Size = Size,
                    Width = Width
                })
            end)
    
            if Ok and Bounds then
                return Bounds
            end
    
            local Estimate = math.min(#Text * Size * 0.52, Width)
            return Vector2.new(Estimate, Size * 1.25)
        end
    
