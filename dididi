    local vehicle = seat.Parent
    if not vehicle then return false end

    local prim = vehicle.PrimaryPart or seat
    local curPos = prim and prim.Position or vehicle:GetPivot().Position
    local belowY = belowY < 0 and belowY or curPos.Y - belowY

    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    coverScreenFull()
    setTweenNoclip(true)
    local tpRot = hrp.CFrame - hrp.CFrame.Position

    setStatus("Tween turun ke bawah...")
    local dropPos = Vector3.new(curPos.X, belowY, curPos.Z)
    lerpChar(curPos, dropPos, UG_SPEED_DOWN, tpRot)

    setStatus("Tween underground ke koordinat...")
    local targetBelow = Vector3.new(targetPos.X, belowY, targetPos.Z)
    local hrp2 = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if hrp2 then lerpChar(hrp2.Position, targetBelow, UG_SPEED_MOVE, tpRot) end

    setStatus("Tween naik ke koordinat...")
    local settlePos = findClearSpot(targetPos, 4)
    if (settlePos - targetPos).Magnitude < 1 then
        settlePos = targetPos + Vector3.new(0, 0, 4)
    end
    local hrp3 = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if hrp3 then lerpChar(hrp3.Position, settlePos, UG_SPEED_UP, tpRot) end

    setTweenNoclip(false)
    for _, Object in pairs(vehicle:GetDescendants()) do
        if Object:IsA("BasePart") then pcall(function() Object.Anchored = false end) end
    end
    task.spawn(autoFixVehicleGround)
    task.wait(0.3)
    uncoverScreen()
    return true
end

