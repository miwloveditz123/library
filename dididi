                if pPos and (pos - pPos).Magnitude <= maxDist then
                    local text = string.lower(pr.ActionText or "")
                    if containsAny(text, words)
                        and not (excludeWords and containsAny(text, excludeWords)) then
                        return pr
                    end
                end
            end
        end
        return nil
    end

    local function findLockPromptNear(pos, maxDist)
        -- "buka kunci" = unlock, jangan disangka lock
        return findPromptByWords(pos, maxDist, PROMPT_LOCK_WORDS, { "unlock", "buka kunci" })
    end

    local function findUnlockPromptNear(pos, maxDist)
        return findPromptByWords(pos, maxDist, PROMPT_UNLOCK_WORDS, nil)
    end

    local function findDoorPromptNear(pos, maxDist)
        -- prompt pintu apa pun (lock/kunci/open/buka/tutup...)
        return findPromptByWords(pos, maxDist, { "lock", "kunci", "gembok", "tutup", "open", "buka", "close" }, nil)
    end

    local function firePromptSmart(pr)
        pcall(function()
            pr.RequiresLineOfSight = false
            pr.HoldDuration = 0
            if fireproximityprompt then
                fireproximityprompt(pr, 0)
            else
                pr:InputHoldBegin()
                task.wait(0.05)
                pr:InputHoldEnd()
            end
        end)
    end

    -- pindah ke pintu: pake metode yang TERBUKTI di script ini (instantRespawnTP),
    -- bukan anchor CFrame (biasanya dipantau / gagal di game).
    local function teleportToPos(p)
        if not p then return false end
        if instantRespawnTP then
            instantRespawnTP(p)
            task.wait(0.5)
            return true
        end
        -- fallback manual kalau instantRespawnTP tidak ada
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if hrp and hum then
                local wasAnchored = hrp.Anchored
                hrp.Anchored = true
                hum.PlatformStand = true
                hrp.CFrame = CFrame.new(p + Vector3.new(0, 1, 0))
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                task.wait(0.6)
                hrp.Anchored = wasAnchored
                hum.PlatformStand = false
            end
        end
        return true
    end

    local function teleportToPrompt(pr)
        if pr then teleportToPos(promptPosition(pr)) end
    end

    local function clickGuiButton(btn)
        pcall(function()
            local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y + 36, 0, true, game, 1)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y + 36, 0, false, game, 1)
        end)
    end

    -- tekan E + klik tombol kunci pintu di GUI (persis pola buyApartment)
    local function pressELock()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.15)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        task.wait(0.7)
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, gui in ipairs(playerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Enabled then
                    for _, btn in ipairs(gui:GetDescendants()) do
                        if (btn:IsA("TextButton") or btn:IsA("ImageButton")) and btn.Visible then
                            local txt = (btn:IsA("TextButton") and btn.Text or btn.Name)
                            if containsAny(txt, BTN_LOCK_WORDS) then
                                clickGuiButton(btn)
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end
        end
    end

    -- tembak SEMUA prompt dekat karakter (persis buyApartment)
    local function fireAllPromptsNear(maxDist)
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrpPos = char.HumanoidRootPart.Position
            for _, prompt in ipairs(Workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") and (prompt.Parent and prompt.Parent:IsA("BasePart")) then
                    if (prompt.Parent.Position - hrpPos).Magnitude <= maxDist then
                        pcall(function()
                            prompt.RequiresLineOfSight = false
                            fireproximityprompt(prompt, 0)
                        end)
                    end
                end
            end
        end
    end

    -- "serbu" gaya buyApartment: semua prompt + E + klik GUI (2x putaran)
    local function interactLockAtDoor()
        fireAllPromptsNear(14)
        pressELock()
        fireAllPromptsNear(14)
        pressELock()
        task.wait(0.8)
    end

    -- urutan 5cx secureDoor (prompt lock/unlock/open, Inggris + Indonesia)
    local function secureDoorSequence(base)
        for _ = 1, 5 do
            if findUnlockPromptNear(base, 30) then return true end -- sudah terkunci
            local lockPr = findLockPromptNear(base, 30)
            if lockPr then
                firePromptSmart(lockPr)
                task.wait(0.5)
                if findUnlockPromptNear(base, 30) then
                    if getgenv().MULTIFARM_DEBUG then warn("[Multifarm] Pintu apart " .. tostring(selectedApartmentData.name or "?") .. " dikunci OK (prompt)") end
                    return true
                end
            else
                -- pintu tertutup tapi belum bisa dikunci -> buka dulu (pola 5cx)
                local openPr = findPromptByWords(base, 30, PROMPT_OPEN_WORDS, { "unlock", "buka kunci" })
                if openPr then firePromptSmart(openPr) end
                task.wait(0.7)
            end
            task.wait(0.5)
        end
        return false
    end

    function AutoLock.tryLockDoor(forceTP)
        if not selectedApartmentData then return false end
        local base = selectedApartmentData.DoorPos or selectedApartmentData.pos
        local doorPr = findDoorPromptNear(base, 40)

        -- 1) pindah ke pintu (cara instantRespawnTP)
        if forceTP ~= false then
            if doorPr then
                teleportToPrompt(doorPr)
            elseif selectedApartmentData.DoorPos then
                teleportToPos(selectedApartmentData.DoorPos)
            end
        end

        -- 2) urutan prompt ala 5cx
        if secureDoorSequence(base) then return true end

        -- 3) serbu E + GUI + semua prompt
        if forceTP ~= false then
            interactLockAtDoor()
            if findUnlockPromptNear(base, 30) then
                if getgenv().MULTIFARM_DEBUG then warn("[Multifarm] Pintu apart " .. tostring(selectedApartmentData.name or "?") .. " dikunci OK (E/GUI)") end
                return true
            end
        end

        -- 4) masih belum? respawn sekali lagi tepat di pintu, ulangi 1x
        if forceTP ~= false and selectedApartmentData.DoorPos then
            if getgenv().MULTIFARM_DEBUG then warn("[Multifarm] Ulangi: respawn tepat di pintu...") end
            teleportToPos(selectedApartmentData.DoorPos)
            if secureDoorSequence(base) then return true end
            interactLockAtDoor()
            if findUnlockPromptNear(base, 30) then
                if getgenv().MULTIFARM_DEBUG then warn("[Multifarm] Pintu apart " .. tostring(selectedApartmentData.name or "?") .. " dikunci OK (respawn)") end
                return true
            end
        end

        if forceTP ~= false then
            if getgenv().MULTIFARM_DEBUG then
                warn("[Multifarm] Peringatan: pintu apart " .. tostring(selectedApartmentData.name or "?") .. " belum terdeteksi terkunci.")
                warn("[Multifarm] Aktifkan getgenv().MULTIFARM_DEBUG = true lalu jalankan ulang untuk log detail.")
            end
        end
        return false
    end

    getgenv().MultifarmAutoLock = AutoLock

    -- Auto lock SELALU hidup (tanpa toggle di GUI)
    getgenv().MULTIFARM_AUTO_LOCK = true

    -- loop: auto kunci tiap interval detik (TANPA teleport biar gak ganggu masak)
    task.spawn(function()
        while true do
            task.wait(AutoLock.Interval)
            if apartmentBought and selectedApartmentData then
                pcall(function() AutoLock.tryLockDoor(false) end)
            end
        end
    end)
end

