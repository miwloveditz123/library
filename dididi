local function findClearSpot(target, radius)
    radius = radius or 4
    local candidates = {
        Vector3.new(0, 0, 0),
        Vector3.new(3, 0, 0),
        Vector3.new(-3, 0, 0),
        Vector3.new(0, 0, 3),
        Vector3.new(0, 0, -3),
        Vector3.new(6, 0, 0),
        Vector3.new(-6, 0, 0),
        Vector3.new(0, 0, 6),
        Vector3.new(0, 0, -6),
    }
    for _, off in ipairs(candidates) do
        local cand = target + off
        local blocked = false
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Player then
                local c = p.Character
                if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChildOfClass("Humanoid") then
                    if (c.HumanoidRootPart.Position - cand).Magnitude < radius then
                        blocked = true
                        break
                    end
                end
            end
        end
        if not blocked then return cand end
    end
    return target
end

