            if type(Preset) ~= "table" then return end
    
            for Key, Value in Preset do
                if Key ~= "Name" and Key ~= "Swatch" and typeof(Value) == "Color3" then
                    Library.Theme[Key] = Value
                end
            end
    
            DeriveTheme()
            Library.ThemeDirty = true
