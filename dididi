    return fired > 0
end

local function addIngredientToPot(toolName)
    local fuzzy = tostring(toolName):lower()
    local function findTool()
        for _, bp in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if bp:IsA("Tool") and tostring(bp.Name):lower():find(fuzzy, 1, true) then return bp end
        end
        local ch = LocalPlayer.Character
        if ch then
            for _, t in ipairs(ch:GetChildren()) do
                if t:IsA("Tool") and tostring(t.Name):lower():find(fuzzy, 1, true) then return t end
            end
        end
        return nil
    end
    if not findTool() then
        setStatus("Stok bahan " .. toolName .. " kosong, beli ulang...")
        buyIngredientRemote(toolName, BUY_ITEM_CODES[toolName] or "", 1)
        task.wait(1)
        if not findTool() then return false end
    end
    local before = countToolByName(fuzzy)
    for attempt = 1, 6 do
        if getgenv().MULTIFARM_STOP then return false end
        local tool = findTool()
        if not tool then return true end
        if tool.Parent ~= LocalPlayer.Character then equipTool(tool) end
        task.wait(0.25)
        fireNearestPrompt()
        fireStovePrompt()
        task.wait(0.2)
        fireNearestPrompt()
        fireStovePrompt()
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
        local w0 = os.clock()
        while os.clock() - w0 < 2 do
            if countToolByName(fuzzy) < before then
                unequipTools()
                return true
            end
            task.wait(0.15)
        end
        unequipTools()
        task.wait(0.3)
    end
    return false
end

