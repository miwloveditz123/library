    end

    -- 8b. SEMENTARA MASAK: TP CARD PICKUP (ambil fake id)
    setStatus("TP CARD PICKUP (ambil fake id)...")
    local CARD_POS = Vector3.new(-39.06999969482422, 1.8511792421340942, -333.780029296875)
    if not TeleportVehicleKAGIFromBelow(CARD_POS) then return false end
    task.wait(0.5)
    ATM_fireNPCPrompt("CardPickup", "Interactions")
    task.wait(1)

    -- 10. MOTOR KE ATM + SWIPE (kalau card masih ada, cari ATM beda & swipe lagi)
    setStatus("TP ATM (swipe)...")
    local usedATM = {}
    local attemptUsed = 0
    while ATM_hasCard() and attemptUsed < 12 do
        if getgenv().MULTIFARM_STOP then break end
        local enabledList = ATM_findEnabledATMs(tostring(usedATM._last or ""))
        local atmModel, atmPrompt = nil, nil
        for _, entry in ipairs(enabledList) do
            if not usedATM[entry.atm.Name] then
                atmModel, atmPrompt = entry.atm, entry.prompt
                break
            end
        end
        if not atmModel then
            ATM_autoFindATM()
            task.wait(1)
            break
        end
        usedATM[atmModel.Name] = true
        usedATM._last = atmModel.Name
        if not TeleportVehicleKAGIFromBelow(atmModel.Position + Vector3.new(0, 0, 2)) then
            attemptUsed = attemptUsed + 1
            task.wait(0.5)
            continue
        end
        task.wait(0.3)
        if atmPrompt then
            pcall(function()
                atmPrompt.HoldDuration = 0
                atmPrompt.RequiresLineOfSight = false
                atmPrompt.MaxActivationDistance = 9e9
            end)
            for _ = 1, 3 do
                pcall(function() fireproximityprompt(atmPrompt) end)
                task.wait()
            end
        end
        task.wait(1)
        local swipeSafe = 0
        while ATM_hasCard() and swipeSafe < 4 do
            if getgenv().MULTIFARM_STOP then break end
            if ATM_ensureCardHeld() then
                task.wait(0.3)
                if ATM_clickSwipeScreen() then
                    MULTIFARM_STAT.CardsSwiped = MULTIFARM_STAT.CardsSwiped + 1
                end
            end
            swipeSafe = swipeSafe + 1
            task.wait(0.5)
        end
        -- card masih ada => ulangi loop dengan ATM lain
        if ATM_hasCard() then
            attemptUsed = attemptUsed + 1
            task.wait(0.5)
        end
    end

    -- 10b. KEMBALI KE APART: langsung fire Empty Bag (ambil marshmallow)
    setStatus("TP APART (fire empty bag)...")
    local stovePos3 = findStovePos()
    if not TeleportVehicleKAGIFromBelow(stovePos3 or cookTarget) then return false end
    task.wait(0.5)
    if stovePos3 then
        local nc3 = noclipKitchenAround(stovePos3)
        TeleportVehicleKAGI(stovePos3)
        task.wait(0.3)
        pcall(fireEmptyBagNow)
        restoreCanCollide(nc3)
    else
        pcall(fireEmptyBagNow)
    end

    -- 11. MOTOR KE POT: ambil potato/chips dari pot
    setStatus("TP POT (ambil potato)...")
    if not TeleportVehicleKAGIFromBelow(POT_POS) then return false end
    task.wait(0.5)
    waitPotAndTakeChips()

    -- 12. MOTOR KE POOR GUY -> FIND HOMELESS -> jual hot chips
    --     Sistem seperti card: kalau hot chips masih ada di backpack,
    --     ulangi cari homeless LAIN (maks 12 upaya)
    setStatus("TP POOR GUY...")
    if not TeleportVehicleKAGIFromBelow(POORGUY_POS) then return false end
    task.wait(0.5)
    potatoChipsToHotChips()

    local usedHomeless = {}
    local attemptH = 0
    while countToolByName("chip") > 0 and attemptH < 12 do
        if getgenv().MULTIFARM_STOP then break end
        attemptH = attemptH + 1
        local npc, npcName = findHomeless(usedHomeless)
        if not npc or not npcName then
            -- Semua homeless dicoba tapi chips masih sisa -> putar ulang dari awal
            warn("[MULTIFARM] HOMELESS: semua dicoba, chips sisa " .. countToolByName("chip") .. ", reset...")
            task.wait(0.5)
            usedHomeless = {}
            npc, npcName = findHomeless(usedHomeless)
            if not npc or not npcName then break end
        end
        usedHomeless[npcName] = true
        local homelessTarget = HOMELESS_COORDS[npcName]
        if homelessTarget then
            if not TeleportVehicleKAGIFromBelow(homelessTarget + Vector3.new(0, 0, 2)) then
                task.wait(0.5)
                continue
            end
            task.wait(0.5)
        end
        sellHotChipsToHomeless(npc, npcName)
        task.wait(0.5)
    end

    -- 13. TP LAMONT: JUAL MARSHMALLOW dulu, abis itu siklus lanjut buy bahan 1 paket lagi
    setStatus("TP LAMONT jual marshmallow...")
    if not TeleportVehicleKAGIFromBelow(Locations.Lamont) then return false end
    task.wait(0.5)
    stepSellMarshmallow()
    task.wait(0.5)

    MULTIFARM_STAT.Cycles = MULTIFARM_STAT.Cycles + 1
    return true
end

