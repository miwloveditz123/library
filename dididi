local function fpsIsPartOfCharacter(part)
    if not part then return false end
    local char = LocalPlayer.Character
    if char and part:IsDescendantOf(char) then return true end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pChar = player.Character
            if pChar and part:IsDescendantOf(pChar) then return true end
        end
    end
    return false
end
local function fpsShouldDelete(part)
    if not part or not part:IsA("BasePart") then return false end
    local name = (part.Name or ""):lower()
    local parentName = part.Parent and (part.Parent.Name or ""):lower() or ""
    for _, protect in ipairs(fpsProtectNames) do
        if name:find(protect:lower()) or parentName:find(protect:lower()) then return false end
    end
    local isTree = false
    local check = part
    for _ = 1, 5 do
        if check and check.Parent then
            local cn = (check.Name or ""):lower()
            if cn:find("tree") or cn:find("palm") or cn:find("bush") or cn:find("plant") or cn:find("foliage") then
                isTree = true
                break
            end
            check = check.Parent
        else
            break
        end
    end
    if not isTree then
        if part.Size.X > 5 or part.Size.Z > 5 then return false end
    end
    if parentName:find("building") or parentName:find("house") or parentName:find("map") then
        if not isTree then
            if part.Size.X < 3 and part.Size.Z < 3 then
            else
                return false
            end
        end
    end
    for _, deleteName in ipairs(fpsDeleteNames) do
        if name:find(deleteName:lower()) then return true end
    end
    if part.Parent and part.Parent:IsA("Model") then
        if parentName:find("decor") or parentName:find("prop") or
           parentName:find("foliage") or parentName:find("trash") or
           parentName:find("rubbish") or parentName:find("garbage") or
           parentName:find("tree") or parentName:find("palm") or
           parentName:find("bush") or parentName:find("plant") then
            return true
        end
    end
    return false
end
