local function sittingStatus(npc)
    if not npc then return "unknown" end
    local function norm(s) return tostring(s or ""):lower():gsub("%s+", "") end
    local function classify(v)
        local s = norm(v)
        if s:find("sitting", 1, true) then return "sitting" end
        if s:find("stand", 1, true) then return "standing" end
        if s:find("sit", 1, true) then return "sitting" end
        return nil
    end
    local okAttr, anim = pcall(function() return npc:GetAttribute("AnimationState") end)
    if okAttr then
        local st = classify(anim)
        if st then return st end
    end
    local holder = nil
    pcall(function()
        for _, d in ipairs(npc:GetDescendants()) do
            local v = d:GetAttribute("AnimationState")
            if v then holder = classify(v); if holder then break end end
        end
    end)
    if holder then return holder end
    return "unknown"
end

local function findHomeless(excludeSet)
    local folder = findHomelessFolder()
    local ready = {}
    local scanned = {}
    if folder then
        for _, name in ipairs(HOMELESS_NAMES) do
            local npc = folder:FindFirstChild(name, true)
            if npc then
                scanned[name] = true
                local st = sittingStatus(npc)
                if st == "sitting" then
                    table.insert(ready, { npc = npc, name = name })
                else
                end
            end
        end
    else
    end
    for _, name in ipairs(HOMELESS_NAMES) do
        if scanned[name] then
        else
            local npc = nil
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == name and (obj:IsA("Model") or obj:IsA("Folder")) then
                    npc = obj
                    break
                end
            end
            if npc then
                scanned[name] = true
                local st = sittingStatus(npc)
                if st == "sitting" then
                    table.insert(ready, { npc = npc, name = name })
                else
                end
            end
        end
    end
    if #ready == 0 then
        return nil, nil
    end
    -- Kalau excludeSet dikasih, pilih homeless duduk yang BELUM dicoba
    -- (sistem kayak card: kalau hot chips masih ada, coba homeless lain dulu)
    if excludeSet then
        for _, entry in ipairs(ready) do
            if not excludeSet[entry.name] then
                return entry.npc, entry.name
            end
        end
        return nil, nil
    end
    return ready[1].npc, ready[1].name
end

local function equipHotChips()
    local keywords = { "hot", "chip", "chips" }
    for attempt = 1, 4 do
        if getgenv().MULTIFARM_STOP then return false end
        local tool = nil
        local backpacks = { LocalPlayer.Character }
        if LocalPlayer.Backpack then table.insert(backpacks, LocalPlayer.Backpack) end
        for _, bp in ipairs(backpacks) do
            if bp then
                for _, ch in ipairs(bp:GetChildren()) do
                    if ch:IsA("Tool") then
                        local low = tostring(ch.Name):lower()
                        for _, kw in ipairs(keywords) do
                            if low:find(kw, 1, true) then
                                tool = ch
                                break
                            end
                        end
                    end
                    if tool then break end
                end
            end
            if tool then break end
        end
        if not tool then
            task.wait(0.5)
        else
            local equipped = tool.Parent == LocalPlayer.Character
            if not equipped then
                local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if h then h:EquipTool(tool) end
                task.wait(0.4)
                equipped = tool.Parent == LocalPlayer.Character
            end
            if equipped then
                return true
            else
                task.wait(0.3)
            end
        end
    end
    return false
end

