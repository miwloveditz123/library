local function openGameSettings()
    if mStop() then return false end
    pcall(function()
        local rbxGui = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
        local settingsPopup = rbxGui and rbxGui:FindFirstChild("Settings", true)
        if not settingsPopup then return end
        local settingsData = settingsPopup:FindFirstChild("GLuaSettingsData", true)
        if settingsData then
            settingsData.Parent = script
            task.wait(0.2)
            settingsData.Parent = settingsPopup
        end
        local modules = rbxGui and rbxGui:FindFirstChild("Modules")
        local settingsMod = modules and modules:FindFirstChild("Settings")
        local settingsApplicator = settingsMod and settingsMod:FindFirstChild("settingsApplicator")
        if settingsApplicator then
            settingsApplicator:Fire(LocalPlayer, settingsData, "open", "owner")
        end
    end)
    return true
end

