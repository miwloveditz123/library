local function wipeAllApartments()
    local destroyed = 0
    local rescued = 0
    local seen = {}
    local targets = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local nm = tostring(obj.Name):lower()
        if nm:find("compactwalkupapt", 1, true) then
            local m = obj:IsA("Model") and obj or obj:FindFirstAncestorWhichIsA("Model")
            if m and not seen[m] then seen[m] = true; table.insert(targets, m) end
        elseif obj:IsA("BasePart") and obj.Name == "Board" then
            local nearApt = false
            for _, apt in ipairs(APARTMENTS) do
                if (obj.Position - apt.pos).Magnitude < 8 then nearApt = true break end
            end
            if nearApt then
                local m = obj:FindFirstAncestorWhichIsA("Model")
                local t = m or obj
                if not seen[t] then seen[t] = true; table.insert(targets, t) end
            end
        end
    end
    for _, model in ipairs(targets) do
        if model:IsA("Model") and model.Parent then
            local saved = {}
            for _, part in ipairs(model:GetDescendants()) do
                if isApartmentPot(part) and part.Parent then
                    pcall(function()
                        part.Anchored = true
                        local cf = part.CFrame
                        part.Parent = Workspace
                        part.CFrame = cf
                        table.insert(saved, part)
                    end)
                end
            end
            local name = model.Name
            pcall(function() model:Destroy() end)
            destroyed = destroyed + 1
            rescued = rescued + #saved
        elseif model.Parent then
            pcall(function() model:Destroy() end)
            destroyed = destroyed + 1
        end
    end
    return destroyed > 0
end

local function deleteApartmentJunk()
    local keepNames = { ["cooking pot"] = true, ["cookpot"] = true, ["cook pot"] = true }
    local aptFolders = {
        "CompactWalkupAPT1", "CompactWalkupAPT2", "CompactWalkupAPT3",
        "CompactWalkupAPT4", "CompactWalkupAPT5", "CompactWalkupAPT6",
    }
    for _, folderName in ipairs(aptFolders) do
        local folder = Workspace:FindFirstChild(folderName)
        if not folder then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == folderName then folder = obj; break end
            end
        end
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character or Instance.new("Model")) then
                    local n = obj.Name:lower()
                    if not keepNames[n] then
                        if n == "housed.0052" then
                            pcall(function()
                                local origSize = obj.Size
                                obj.Size = Vector3.new(origSize.X, origSize.Y * 0.05, origSize.Z)
