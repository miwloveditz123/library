local _tweenNoclipCache = {}
local _tweenWasSeated = false

local function _getSeatedVehicle()
    local ch = Player.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if not seat then return nil end
    return seat:FindFirstAncestorOfClass("Model"), seat
end

local function _isWheelPart(part)
    local n = (part.Name or ""):lower()
    if n:find("wheel") or n:find("tire") or n:find("ban") or n:find("rod") then return true end
    if part:FindFirstChildOfClass("WheelConstraint") then return true end
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Attachment") or child:IsA("WheelConstraint") then return true end
    end
    return false
end

local _tweenWheelData = nil

local function snapshotVehicleWheels()
    _tweenWheelData = nil
    local veh = _getSeatedVehicle()
    if not veh then return end
    pcall(function()
        local pivot = veh:GetPivot()
        local list = {}
        for _, part in ipairs(veh:GetDescendants()) do
            pcall(function()
                if part:IsA("BasePart") and _isWheelPart(part) then
                    table.insert(list, { part = part, rel = pivot:Inverse() * part.CFrame })
                end
            end)
        end
        _tweenWheelData = #list > 0 and list or nil
    end)
end

local function applyVehicleWheels()
    local data = _tweenWheelData
    if not data then return end
    local veh = _getSeatedVehicle()
    if not veh then return end
    pcall(function()
        local pivot = veh:GetPivot()
        for _, w in ipairs(data) do
            if w.part and w.part.Parent then
                pcall(function() w.part.CFrame = pivot * w.rel end)
            end
        end
    end)
end

local function autoFixVehicleGround()
    local startVeh = _getSeatedVehicle()
    if not startVeh then return end
    local wheelRefs = {}
    pcall(function()
        local pivot = startVeh:GetPivot()
        for _, part in ipairs(startVeh:GetDescendants()) do
            if part:IsA("BasePart") and _isWheelPart(part) then
                table.insert(wheelRefs, { part = part, rel = pivot:Inverse() * part.CFrame })
            end
        end
    end)
    for _ = 1, 10 do
        if mStop() then break end
        pcall(function()
            local veh = _getSeatedVehicle()
            if not veh then return end
            local pivot = veh:GetPivot()
            local lowY = math.huge
            for _, part in ipairs(veh:GetDescendants()) do
                pcall(function()
                    if part:IsA("BasePart") then
                        local partLow = part.CFrame.Position.Y - (part.Size.Y / 2)
                        if partLow < lowY then lowY = partLow end
                    end
                end)
            end
            if lowY == math.huge or not pivot then return end
            local filter = { Player.Character, veh }
            local rayP = RaycastParams.new()
            rayP.FilterType = Enum.RaycastFilterType.Blacklist
            rayP.FilterDescendantsInstances = filter
            local hit = workspace:Raycast(
                CFrame.new(pivot.Position.X, pivot.Position.Y, pivot.Position.Z).Position,
                Vector3.new(0, -1, 0) * 30, rayP
            )
            if hit and hit.Instance and hit.Instance:IsA("BasePart") and hit.Instance.CanCollide then
                local groundY = hit.Position.Y
                if lowY < groundY - 0.3 then
                    veh:PivotTo(veh:GetPivot() + Vector3.new(0, groundY - lowY, 0))
                end
            end
            for _, w in ipairs(wheelRefs) do
                if w.part and w.part.Parent then
                    pcall(function() w.part.CFrame = veh:GetPivot() * w.rel end)
                end
            end
        end)
        task.wait(0.5)
    end
end

local function setTweenNoclip(enabled)
    local ch = Player.Character
    if not ch then return end
    if enabled then
        _tweenNoclipCache = {}
        local hum = ch:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        _tweenWasSeated = seat ~= nil
        for _, part in ipairs(ch:GetDescendants()) do
            if part:IsA("BasePart") then
                _tweenNoclipCache[part] = { coll = part.CanCollide, anc = part.Anchored }
                pcall(function() part.CanCollide = false end)
            end
        end
        if not _tweenWasSeated and hum then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.FallingNoCollisions) end)
            pcall(function() hum.PlatformStand = true end)
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if hrp then pcall(function() hrp.Anchored = true end) end
        end
        if seat then
            local vehicle = seat:FindFirstAncestorOfClass("Model")
            if vehicle then
                for _, part in ipairs(vehicle:GetDescendants()) do
                    if part:IsA("BasePart") and not _tweenNoclipCache[part] then
                        _tweenNoclipCache[part] = { coll = part.CanCollide, anc = part.Anchored }
                        pcall(function() part.CanCollide = false end)
                    end
                end
            end
        end
        snapshotVehicleWheels()
    else
        local hum = ch:FindFirstChildOfClass("Humanoid")
        for part, data in pairs(_tweenNoclipCache) do
            pcall(function()
                if part and part.Parent and data then
                    part.CanCollide = data.coll
                    if not data.anc then part.Anchored = false end
                end
            end)
        end
        _tweenNoclipCache = {}
        if hum then
            pcall(function() hum.PlatformStand = false end)
            if not _tweenWasSeated then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
            end
        end
        _tweenWasSeated = false
        _tweenWheelData = nil
    end
end

local function lerpChar(fromPos, toPos, speed, lockRot)
    local dist = (toPos - fromPos).Magnitude
    local travelT = dist / speed
    local elapsed = 0
    if not lockRot then
        lockRot = (Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") and Player.Character:FindFirstChild("HumanoidRootPart").CFrame) or CFrame.new()
        lockRot = lockRot - lockRot.Position
    end
    while elapsed < travelT and not mStop() do
        local hrp2 = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp2 then break end
        local t = math.clamp(elapsed / travelT, 0, 1)
        local newPos = fromPos:Lerp(toPos, t)
        local offset = newPos - hrp2.Position
        for _, p in pairs(Player.Character:GetDescendants()) do
            if p:IsA("BasePart") and p ~= hrp2 then pcall(function() p.CFrame = p.CFrame + offset end) end
        end
        hrp2.CFrame = CFrame.new(newPos) * lockRot
        hrp2.AssemblyLinearVelocity = Vector3.zero
        hrp2.AssemblyAngularVelocity = Vector3.zero
        local veh, seat = _getSeatedVehicle()
        if veh then
            pcall(function()
                local vehRoot = veh.PrimaryPart or veh:FindFirstChildOfClass("BasePart")
                if vehRoot then
                    local off = vehRoot.Position - hrp2.Position
                    veh:PivotTo(CFrame.new(newPos + off) * lockRot)
                    applyVehicleWheels()
                end
            end)
        end
        local _, dt = RunService.Stepped:Wait()
        dt = math.min(dt or 0.035, 0.035)
        elapsed = elapsed + dt
    end
    if not mStop() then
        local hrp3 = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if hrp3 then hrp3.CFrame = CFrame.new(toPos) * lockRot end
        local veh, seat = _getSeatedVehicle()
        if veh then
            pcall(function()
                local vehRoot = veh.PrimaryPart or veh:FindFirstChildOfClass("BasePart")
                if vehRoot then
                    local off = vehRoot.Position - hrp3.Position
                    veh:PivotTo(CFrame.new(toPos + off) * lockRot)
                    applyVehicleWheels()
                end
            end)
        end
    end
end

