-- Load 100% original Da7mu Zolar UI Library
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/miwloveditz123/library/refs/heads/main/zolar"))()

-- Patch: tambah background gambar ke Window
local OriginalWindow = Library.Window

Library.Window = function(Self, Params)
    local Window = OriginalWindow(Self, Params)

    -- Buat ImageLabel background
    local BgImage = Instance.new("ImageLabel")
    BgImage.Name = "\0"
    BgImage.Parent = Window.Items.Main.Instance
    BgImage.BackgroundTransparency = 1
    BgImage.Size = UDim2.new(1, 0, 1, 0)
    BgImage.Position = UDim2.fromOffset(0, 0)
    BgImage.ScaleType = Enum.ScaleType.Crop
    BgImage.ImageTransparency = 0
    BgImage.ZIndex = 1
    BgImage.BorderSizePixel = 0

    Instance.new("UICorner", BgImage).CornerRadius = UDim.new(0, 10)

    -- Download & set gambar
    Library:Thread(function()
        pcall(function()
            local bgUrl = "https://media.discordapp.net/attachments/1552945767596036116/1562040122130698320/ChatGPT_Image_Sep_20_2026_02_54_37_PM.png?ex=6ae5b9ba&is=6ae4683a&hm=2dc752aa8d63f0b7a1b4838810c3bc6253c8632e33343ba627683515643458b0&=&format=webp&quality=lossless&width=640&height=640"
            local bgPath = Library.AssetsFolder .. "/CustomBackground.png"

            if isfile and isfile(bgPath) then
                local existing = readfile(bgPath)
                if #existing < 2000 or string.sub(existing, 1, 4) == "RIFF" then
                    delfile(bgPath)
                end
            end

            if not isfile or not isfile(bgPath) then
                local body = game:HttpGet(bgUrl)
                if #body > 2000 and string.sub(body, 1, 4) ~= "RIFF" then
                    writefile(bgPath, body)
                end
            end

            if isfile and isfile(bgPath) then
                BgImage.Image = getcustomasset(bgPath)
            end
        end)
    end)

    return Window
end

return Library
